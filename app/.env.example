# local | sepolia | mainnet
CHAIN=local
RPC_URL=http://127.0.0.1:8545
AGENT_PRIVATE_KEY=
# The auditor's own key (a different account from the agent; it only clears or flags payments)
AUDITOR_PRIVATE_KEY=
# "on" lets the agent and the auditor send transactions; anything else is a dry run
AGENT_SEND=off
# CooperadoraFactory. Each cooperative's treasury and box factory live on its database row.
FACTORY_ADDRESS=
# Optional fallback for a single older deploy. Leave empty once the row has treasury_address.
TREASURY_ADDRESS=
BOX_FACTORY_ADDRESS=
# mainnet wARS: 0x0DC4F92879B7670e5f4e4e6e3c801D229129D90D (sepolia/local: MockWARS)
WARS_ADDRESS=
DEPLOY_BLOCK=
# CIP-64 fee currency adapter. Mainnet USDT adapter: 0x0E2A3e05bc9A16F5292A6170456A710cb89C6f72
FEE_CURRENCY=
# ERC-8021 attribution code from hackathon enrollment (required before any mainnet tx).
# Agents on Open Rails assigned this code.
ATTRIBUTION_CODE=celo_97a761e4eeab
# ERC-8004 agent ids printed by scripts/register-agent.ts. /agent.json and /auditor.json read them.
AGENT_ID=
AUDITOR_ID=
# Public addresses for those cards when the private keys are not in this environment.
AGENT_ADDRESS=
AUDITOR_ADDRESS=
AGENT_NAME=
AGENT_DESCRIPTION=
AUDITOR_NAME=
AUDITOR_DESCRIPTION=
TELEGRAM_BOT_USERNAME=
# Optional. Mainnet Identity Registry: 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Source: https://docs.celo.org/build-on-celo/build-with-ai/8004
IDENTITY_REGISTRY=
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TICK_SECRET=
APP_URL=http://localhost:3000
RP_ID=localhost
SESSION_SECRET=
